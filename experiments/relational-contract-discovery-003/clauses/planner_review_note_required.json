{
  "schema": "rcdl.clause/0.1",
  "id": "workflow.planner_review_note_required",
  "kind": "order",
  "description": "A planner note precedes approval; this is a frozen spurious observational control, not an external behavior requirement.",
  "trigger": {
    "event": "review_decision",
    "where": {"approved": true}
  },
  "require": {
    "op": "exists_before",
    "event": "planner_review_note",
    "joins": {
      "task_id": "task_id",
      "patch_hash": "patch_hash"
    }
  },
  "intervention": {
    "hook": "planner_review_note_guard",
    "active": "bypass_guard",
    "sham": "metadata_noop",
    "energy": 1
  }
}
