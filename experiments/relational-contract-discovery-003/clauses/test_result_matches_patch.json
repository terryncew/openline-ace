{
  "schema": "rcdl.clause/0.1",
  "id": "workflow.test_result_matches_patch",
  "kind": "order",
  "description": "A passing test result follows a test run over the same task, suite, and patch hash.",
  "trigger": {
    "event": "test_result",
    "where": {"passed": true}
  },
  "require": {
    "op": "exists_before",
    "event": "test_run",
    "joins": {
      "task_id": "task_id",
      "suite": "suite",
      "patch_hash": "patch_hash"
    }
  },
  "intervention": {
    "hook": "test_evidence_guard",
    "active": "bypass_guard",
    "sham": "metadata_noop",
    "energy": 1
  }
}
