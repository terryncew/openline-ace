{
  "schema": "rcdl.clause/0.1",
  "id": "raft.commit_audit_marker_before_commit",
  "kind": "order",
  "description": "A local audit marker precedes commit advancement; this is a frozen spurious-control candidate, not a Raft requirement.",
  "trigger": {
    "event": "commit_advance"
  },
  "require": {
    "op": "exists_before",
    "event": "commit_audit_marker",
    "joins": {
      "node": "node",
      "term": "term",
      "index": "index",
      "digest": "digest"
    }
  },
  "intervention": {
    "hook": "commit_audit_guard",
    "active": "bypass_guard",
    "sham": "metadata_noop",
    "energy": 1
  }
}
